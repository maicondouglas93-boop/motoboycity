// Schema Prisma — Fase 2A (estrutura de domínio conceitual).
//
// Baseado em docs/architecture/phase-2a-domain-model.md.
// Decisões provisórias aplicadas nesta fase (ver relatório da Fase 2A):
//   - DeliveryStatus NÃO inclui RETURNING ainda (decisão funcional pendente).
//   - Fila de despacho/presença ao vivo NÃO é modelada aqui (fica para Redis).
//   - Nenhuma regra de negócio, endpoint ou autenticação funcional é implementada.
//
// Convenções aplicadas (decisão de estilo, não de negócio):
//   - Nomes de modelo em PascalCase (Prisma) mapeados para tabelas snake_case
//     via @@map/@map, seguindo convenção usual de PostgreSQL.
//   - Valores monetários usam Decimal(10,2); coordenadas usam Decimal(10,7).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserType {
  COMPANY_MEMBER
  DRIVER
  ADMIN
}

enum CompanyMemberRole {
  OWNER
  OPERATOR
}

enum CompanyStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

enum DriverApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DriverAccountStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum DriverAvailability {
  AVAILABLE
  UNAVAILABLE
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
}

enum DriverDocumentType {
  SELFIE
  RG
  CNH_FRONT
  CNH_BACK
  PROOF_OF_ADDRESS
}

enum VehicleDocumentType {
  CRLV
  VEHICLE_BACK_PHOTO
}

enum DocumentReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// NOTA: "RETURNING" (Retorno ao Local de Coleta) foi deliberadamente omitido.
// Ver docs/architecture/phase-2a-domain-model.md, seção 15, questão 1.
enum DeliveryStatus {
  SCHEDULED
  AWAITING_DRIVER
  ACCEPTED
  COLLECTED
  DELIVERED
  /// Motoboy coletou mas nao conseguiu entregar. A mercadoria volta para a
  /// loja e a empresa paga a corrida normal, entao FAILED fecha pela mesma
  /// confirmacao de retorno que DELIVERED — nao e um cancelamento.
  FAILED
  COMPLETED
  CANCELLED
  AWAITING_PAYMENT
}

enum DeliveryFailureReason {
  RECIPIENT_ABSENT
  ADDRESS_NOT_FOUND
  RECIPIENT_REFUSED
  OTHER
}

enum DeliveryAddressType {
  PICKUP
  DROPOFF
}

enum PaymentMethod {
  BILLED
  ONLINE
}

/// Como o destinatário paga a compra à empresa. Não é a forma de cobrança
/// da plataforma (`PaymentMethod`) e não movimenta carteira ou fatura.
enum CustomerPaymentMethod {
  PREPAID
  CARD
  CASH
  PIX
}

enum DeliveryOfferResponse {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum WalletTransactionType {
  CREDIT_REPASSE
  DEBIT_WITHDRAWAL
  DEBIT_FEE
  CREDIT_ADVANCE_RELEASE
  CREDIT_ADJUSTMENT
  DEBIT_ADJUSTMENT
  CREDIT_REFUND
}

enum WalletTransactionStatus {
  PENDING
  RELEASED
  CANCELLED
}

enum WithdrawalRequestStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum AdvanceRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum IntegrationProvider {
  IFOOD
  ANYFONE
  PDV_INTEGRADO
  DELIVERY_MUCH
  JA_DELIVERY
  CARDAPIO_WEB
  ANOTA_AI
  AIQFOME
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum NotificationType {
  NEW_DELIVERY_OFFER
  DELIVERY_STATUS_CHANGED
  INVOICE_DUE
  WITHDRAWAL_APPROVED
  ADVANCE_APPROVED
  ADMIN_ALERT
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
}

enum NotificationChannel {
  PUSH
  REALTIME
  EMAIL
}

/// Como o adicional e calculado. O MOTIVO da taxa (chuva, feriado, madrugada)
/// deixou de ser enum e virou nome livre, para o admin criar quantas quiser
/// sem depender de uma migracao a cada motivo novo.
/// Faixa em que a operação aceita pedidos. Uma linha por intervalo, então um
/// dia com pausa de almoço tem duas — é assim que se fecha o meio do dia sem
/// precisar de campo de "intervalo".
model BusinessHour {
  id       String @id @default(uuid())
  regionId String

  /// 0 = domingo .. 6 = sábado.
  weekday Int

  /// Minutos desde a meia-noite no fuso operacional. `endMinute` menor ou igual
  /// a `startMinute` atravessa a meia-noite — o caso de quem fecha às 2h.
  startMinute Int
  endMinute   Int

  region Region @relation(fields: [regionId], references: [id])

  @@index([regionId, weekday])
  @@map("business_hours")
}

enum SurchargeType {
  PERCENTAGE
  FIXED
}

// ============================================================================
// 1. IDENTIDADE / ACESSO
// ============================================================================

/// Identidade de autenticação genérica, compartilhada pelos três perfis
/// (empresa, entregador, admin). Nunca armazenar senha em texto puro.
model User {
  id           String   @id @default(uuid())
  type         UserType
  name         String
  email        String   @unique
  phone        String
  passwordHash String

  avatarExternalFileId String?
  avatarUrl            String?

  driver                  Driver?
  adminUser               AdminUser?
  companyMemberships      CompanyTeamMember[]
  notifications           Notification[]
  deliveryStatusChanges   DeliveryStatusHistory[]
  invoiceStatusChanges    InvoiceStatusHistory[]
  withdrawalStatusChanges WithdrawalRequestStatusHistory[]
  companiesApproved       Company[]                        @relation("CompanyApprovedBy")
  driversReviewed         Driver[]                         @relation("DriverReviewedBy")
  platformSettingsEdits   PlatformSettings[]               @relation("PlatformSettingsUpdatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@map("users")
}

/// Perfil de um funcionário da plataforma com acesso ao admin-web.
/// Sem tela de permissões granulares capturada na Fase 0 — "level" é um
/// placeholder livre, não um enum, até essa necessidade ser confirmada.
model AdminUser {
  id     String  @id @default(uuid())
  userId String  @unique
  level  String?

  user User @relation(fields: [userId], references: [id])

  reviewedDriverDocuments  DriverDocument[]
  reviewedVehicleDocuments VehicleDocument[]

  createdAt DateTime @default(now())

  @@map("admin_users")
}

/// Vínculo entre um User e uma Company, com papel dentro da empresa.
model CompanyTeamMember {
  id        String            @id @default(uuid())
  companyId String
  userId    String
  role      CompanyMemberRole
  active    Boolean           @default(true)

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  joinedAt DateTime @default(now())

  @@unique([companyId, userId])
  @@map("company_team_members")
}

// ============================================================================
// 2. EMPRESA
// ============================================================================

model Company {
  id        String        @id @default(uuid())
  legalName String
  tradeName String
  document  String        @unique
  status    CompanyStatus @default(PENDING_APPROVAL)
  regionId  String

  region Region @relation(fields: [regionId], references: [id])

  approvedByUserId String?
  approvedAt       DateTime?
  approvedBy       User?     @relation("CompanyApprovedBy", fields: [approvedByUserId], references: [id])

  teamMembers  CompanyTeamMember[]
  addresses    CompanyAddress[]
  deliveries   Delivery[]
  wallet       Wallet?
  invoices     Invoice[]
  integrations Integration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([regionId])
  @@map("companies")
}

/// Endereços da empresa — inclui o endereço principal de coleta
/// (isPrimary = true) e os endereços favoritos.
model CompanyAddress {
  id         String   @id @default(uuid())
  companyId  String
  label      String?
  street     String
  number     String
  complement String?
  city       String
  state      String
  zip        String
  lat        Decimal? @db.Decimal(10, 7)
  lng        Decimal? @db.Decimal(10, 7)
  isPrimary  Boolean  @default(false)

  company Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("company_addresses")
}

// ============================================================================
// 3. ENTREGADOR
// ============================================================================

model Driver {
  id             String               @id @default(uuid())
  userId         String               @unique
  cpf            String               @unique
  birthDate      DateTime             @db.Date
  pixKey         String
  pixKeyType     String
  hasCnpj        Boolean              @default(false)
  regionId       String
  approvalStatus DriverApprovalStatus @default(PENDING)
  accountStatus  DriverAccountStatus  @default(ACTIVE)
  availability   DriverAvailability   @default(UNAVAILABLE)
  appVersion     String?

  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewedBy       User?     @relation("DriverReviewedBy", fields: [reviewedByUserId], references: [id])

  /// Última posição conhecida — CACHE de conveniência (ex.: mapa do admin),
  /// não um histórico de GPS. Ver docs/architecture/phase-2a-domain-model.md
  /// seção 4 ("GPS"). Alta frequência de localização fica em Redis/realtime.
  lastKnownLat Decimal?  @db.Decimal(10, 7)
  lastKnownLng Decimal?  @db.Decimal(10, 7)
  lastSeenAt   DateTime?

  user   User   @relation(fields: [userId], references: [id])
  region Region @relation(fields: [regionId], references: [id])

  vehicles       Vehicle[]
  documents      DriverDocument[]
  wallet         Wallet?
  serviceTypes   DriverServiceType[]
  deliveries     Delivery[]
  offers         DeliveryOffer[]
  presenceLogs   DriverPresenceLog[]
  trackingPoints DeliveryLocationPoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approvalStatus])
  @@index([accountStatus])
  @@index([regionId, availability])
  @@map("drivers")
}

/// Histórico de veículos do entregador. Regra de aplicação (não expressa
/// como constraint de banco nesta fase): no máximo 1 veículo com
/// status=ACTIVE por entregador. Ver questão em aberto na Fase 2A.
model Vehicle {
  id            String        @id @default(uuid())
  driverId      String
  plate         String
  city          String
  color         String
  hasBagOrTrunk Boolean       @default(false)
  status        VehicleStatus @default(ACTIVE)

  driver    Driver            @relation(fields: [driverId], references: [id])
  documents VehicleDocument[]

  createdAt DateTime @default(now())

  @@index([driverId, status])
  @@map("vehicles")
}

/// Documentos pessoais do entregador. Campos condicionais (rgIssuer,
/// cnh*) só se aplicam conforme "type" — ver nota sobre DriverIdentityInfo
/// no relatório da Fase 2A: mantido como está por não haver exigência
/// técnica do Prisma que force a separação; decisão sinalizada, não oculta.
model DriverDocument {
  id                    String               @id @default(uuid())
  driverId              String
  type                  DriverDocumentType
  externalFileId        String
  url                   String
  reviewStatus          DocumentReviewStatus @default(PENDING_REVIEW)
  reviewedByAdminUserId String?

  rgIssuer          String?
  cnhNumber         String?
  cnhExpiresAt      DateTime? @db.Date
  cnhIsPaidActivity Boolean?

  driver          Driver     @relation(fields: [driverId], references: [id])
  reviewedByAdmin AdminUser? @relation(fields: [reviewedByAdminUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([driverId, type])
  @@map("driver_documents")
}

/// Documentos do veículo (CRLV, foto traseira) — separados de
/// DriverDocument porque pertencem ao veículo, não à pessoa.
model VehicleDocument {
  id                    String               @id @default(uuid())
  vehicleId             String
  type                  VehicleDocumentType
  externalFileId        String
  url                   String
  reviewStatus          DocumentReviewStatus @default(PENDING_REVIEW)
  reviewedByAdminUserId String?

  vehicle         Vehicle    @relation(fields: [vehicleId], references: [id])
  reviewedByAdmin AdminUser? @relation(fields: [reviewedByAdminUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([vehicleId, type])
  @@map("vehicle_documents")
}

/// Sessões de presença online/offline, para relatórios (ex.: horas online).
/// NÃO é a fila ao vivo — isso fica em Redis, fora do Postgres.
model DriverPresenceLog {
  id            String    @id @default(uuid())
  driverId      String
  wentOnlineAt  DateTime
  wentOfflineAt DateTime?

  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId])
  @@map("driver_presence_logs")
}

/// Junção N:N explícita entre Driver e ServiceType, permitindo que um
/// entregador atenda mais de uma modalidade de serviço no futuro.
model DriverServiceType {
  id            String  @id @default(uuid())
  driverId      String
  serviceTypeId String
  isPrimary     Boolean @default(true)

  driver      Driver      @relation(fields: [driverId], references: [id])
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])

  @@unique([driverId, serviceTypeId])
  @@map("driver_service_types")
}

// ============================================================================
// 4. PEDIDO
// ============================================================================

model Delivery {
  id            String         @id @default(uuid())
  displayNumber Int            @unique @default(autoincrement())
  companyId     String
  driverId      String?
  serviceTypeId String
  status        DeliveryStatus @default(SCHEDULED)

  /// Agrupa pedidos criados juntos numa chamada de despacho em lote.
  /// Nulo representa um pedido avulso. O lote não tem entidade própria:
  /// todas as entregas com o mesmo ID compartilham oferta, aceite, recusa e
  /// cancelamento como uma unidade, mantendo uma DeliveryOffer auditável por
  /// entrega.
  batchId String?

  /// Carimbo do status atual — denormalizado para leitura rápida;
  /// a trilha completa vive em DeliveryStatusHistory.
  statusChangedAt DateTime @default(now())

  /// Preenchidos apenas quando a entrega falha. `failureNote` e obrigatoria
  /// quando o motivo e OTHER — a validacao cuida disso.
  failureReason DeliveryFailureReason?
  failureNote   String?
  failedAt      DateTime?
  scheduledAt   DateTime?
  distanceKm    Decimal?               @db.Decimal(6, 2)

  /// true (padrão): destino informado e preço calculado/congelado na
  /// criação, como sempre foi. false: pedido nasce sem DROPOFF — distanceKm/
  /// totalValue/driverValue/platformValue ficam nulos até markDelivered()
  /// capturar lat/lng do motoboy na entrega e calcular retroativamente.
  /// Mesmo valor obrigatório em todos os itens de um lote (validado em Zod).
  destinationKnownAtCreation Boolean @default(true)

  /// Nulos enquanto destinationKnownAtCreation=false e a entrega não foi
  /// concluída; congelados na criação quando destinationKnownAtCreation=true.
  totalValue    Decimal? @db.Decimal(10, 2)
  driverValue   Decimal? @db.Decimal(10, 2)
  platformValue Decimal? @db.Decimal(10, 2)

  /// Taxa adicional vigente no momento da criação, congelada como nome e valor
  /// e NÃO como chave estrangeira: renomear ou excluir a taxa depois não pode
  /// reescrever o que a fatura já emitida dizia. Nulos quando nenhuma taxa
  /// estava valendo.
  surchargeLabel String?       @db.VarChar(80)
  surchargeValue Decimal?      @db.Decimal(10, 2)
  paymentMethod  PaymentMethod
  invoiceId      String?

  /// Metadados operacionais informados pela empresa. São opcionais para
  /// preservar pedidos antigos e integrações que ainda não os enviam.
  recipientName         String?
  recipientPhone        String?
  externalOrderNumber   String?
  driverNote            String?
  customerPaymentMethod CustomerPaymentMethod?

  requiresDeliveryProof          Boolean @default(false)
  requiresCollectionRecipient    Boolean @default(false)
  pickupSurchargeChargedToDriver Boolean @default(false)

  /// Retorno ao local de coleta: flag marcada pela empresa na criação +
  /// valor congelado (de PricingTable.returnFee no momento da criação).
  /// Não é um DeliveryStatus novo — acontece entre DELIVERED e COMPLETED.
  requiresReturn Boolean  @default(false)
  returnValue    Decimal? @db.Decimal(10, 2)

  company     Company     @relation(fields: [companyId], references: [id])
  driver      Driver?     @relation(fields: [driverId], references: [id])
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])
  invoice     Invoice?    @relation(fields: [invoiceId], references: [id])

  addresses          DeliveryAddress[]
  statusHistory      DeliveryStatusHistory[]
  offers             DeliveryOffer[]
  walletTransactions WalletTransaction[]
  trackingPoints     DeliveryLocationPoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([driverId, status])
  @@index([status, createdAt])
  @@index([companyId, createdAt])
  @@index([companyId, externalOrderNumber])
  @@index([invoiceId])
  @@index([batchId])
  @@map("deliveries")
}

/// Pontos brutos de localização durante uma entrega ativa. São operacionais,
/// não evidência automática de status: o job de retenção remove-os após 30
/// dias, conforme a política de privacidade confirmada.
model DeliveryLocationPoint {
  id         String   @id @default(uuid())
  deliveryId String
  driverId   String
  lat        Decimal  @db.Decimal(10, 7)
  lng        Decimal  @db.Decimal(10, 7)
  accuracy   Decimal? @db.Decimal(8, 2)
  capturedAt DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id])
  driver   Driver   @relation(fields: [driverId], references: [id])

  @@index([deliveryId, capturedAt])
  @@index([capturedAt])
  @@map("delivery_location_points")
}

/// Endereço de coleta ou de entrega de um pedido — é um snapshot
/// (copiado no momento do pedido), não uma referência mutável a
/// CompanyAddress.
model DeliveryAddress {
  id         String              @id @default(uuid())
  deliveryId String
  type       DeliveryAddressType

  /// Estruturado quando o destino é conhecido na criação (o caso comum) ou
  /// quando é PICKUP. Nulo apenas para um DROPOFF capturado por GPS na
  /// entrega (Delivery.destinationKnownAtCreation=false) — sem geocodificação
  /// reversa, só lat/lng ficam preenchidos nesse caso.
  street     String?
  number     String?
  complement String?
  city       String?
  state      String?
  zip        String?

  lat           Decimal? @db.Decimal(10, 7)
  lng           Decimal? @db.Decimal(10, 7)
  referenceNote String?

  delivery Delivery @relation(fields: [deliveryId], references: [id])

  @@index([deliveryId])
  @@map("delivery_addresses")
}

/// Trilha de auditoria de mudança de status — fonte de verdade para
/// cálculo de tempos médios (aceite, coleta, entrega). Append-only.
model DeliveryStatusHistory {
  id              String          @id @default(uuid())
  deliveryId      String
  fromStatus      DeliveryStatus?
  toStatus        DeliveryStatus
  changedAt       DateTime        @default(now())
  changedByUserId String?
  note            String?

  /// Quando o evento aconteceu DE VERDADE na rua, informado pelo motoboy que
  /// esqueceu de tocar o botão na hora. Nulo na esmagadora maioria das linhas:
  /// só existe em marcação retroativa.
  ///
  /// `changedAt` continua sendo quando a linha foi ESCRITA. Sobrescrevê-lo com
  /// o horário declarado faria a trilha de auditoria mentir sobre a própria
  /// criação, e é justamente a distância entre os dois números que denuncia uma
  /// declaração esticada. O relatório de etapas usa `occurredAt ?? changedAt`;
  /// a auditoria usa `changedAt`.
  occurredAt DateTime?

  delivery      Delivery @relation(fields: [deliveryId], references: [id])
  changedByUser User?    @relation(fields: [changedByUserId], references: [id])

  @@index([deliveryId])
  @@map("delivery_status_history")
}

/// Cada oferta de um pedido a um entregador específico. Existe para
/// permitir métricas reais de aceite/recusa sem depender da fila ao vivo
/// (que é efêmera, em Redis).
model DeliveryOffer {
  id          String                @id @default(uuid())
  deliveryId  String
  driverId    String
  offeredAt   DateTime              @default(now())
  respondedAt DateTime?
  response    DeliveryOfferResponse @default(PENDING)

  delivery Delivery @relation(fields: [deliveryId], references: [id])
  driver   Driver   @relation(fields: [driverId], references: [id])

  @@index([driverId, response])
  @@index([deliveryId])
  @@map("delivery_offers")
}

// ============================================================================
// 5. FINANCEIRO
// ============================================================================

/// Carteira de uma empresa OU de um entregador (nunca ambos, nunca
/// nenhum). O saldo NÃO é um campo livremente editável: os campos
/// "cached*" são cache derivado de WalletTransaction, nunca a fonte da
/// verdade. Invariante companyId XOR driverId é validada na aplicação —
/// Prisma não oferece suporte estável a CHECK constraints nesta versão.
model Wallet {
  id String @id @default(uuid())

  companyId String? @unique
  driverId  String? @unique

  cachedAvailableBalance Decimal @default(0) @db.Decimal(10, 2)
  cachedBlockedBalance   Decimal @default(0) @db.Decimal(10, 2)

  company Company? @relation(fields: [companyId], references: [id])
  driver  Driver?  @relation(fields: [driverId], references: [id])

  transactions       WalletTransaction[]
  withdrawalRequests WithdrawalRequest[]
  advanceRequests    AdvanceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

/// Lançamento financeiro — ledger append-only, fonte de verdade do saldo.
/// Nenhuma lógica deve alterar o saldo de uma Wallet sem criar uma linha
/// aqui.
model WalletTransaction {
  id       String                  @id @default(uuid())
  walletId String
  type     WalletTransactionType
  status   WalletTransactionStatus @default(PENDING)
  amount   Decimal                 @db.Decimal(10, 2)

  /// Chave de idempotência da origem financeira. Para o repasse automático,
  /// é derivada da entrega; assim uma repetição concorrente de conclusão não
  /// cria crédito duplicado na carteira do entregador.
  idempotencyKey String? @unique

  relatedDeliveryId String?

  /// Referências informativas (IDs simples, não relações Prisma) para
  /// evitar uma segunda relação duplicada com WithdrawalRequest/
  /// AdvanceRequest. O vínculo autoritativo saque↔transação é
  /// WithdrawalRequest.walletTransactionId (abaixo).
  relatedWithdrawalRequestId String?
  relatedAdvanceRequestId    String?

  releaseAt  DateTime?
  notaFiscal String?

  wallet            Wallet             @relation(fields: [walletId], references: [id])
  delivery          Delivery?          @relation(fields: [relatedDeliveryId], references: [id])
  withdrawalRequest WithdrawalRequest?

  createdAt DateTime @default(now())

  @@index([walletId, status])
  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model WithdrawalRequest {
  id              String  @id @default(uuid())
  walletId        String
  requestedAmount Decimal @db.Decimal(10, 2)
  feeAmount       Decimal @db.Decimal(10, 2)
  netAmount       Decimal @db.Decimal(10, 2)

  /// Snapshot dos dados de recebimento no momento da solicitação — ver
  /// questão em aberto na Fase 2A sobre reaproveitar dados padrão do Driver.
  bankName          String?
  bankAgency        String?
  bankAccount       String?
  accountHolderName String?
  pixKey            String?
  pixKeyType        String?

  status              WithdrawalRequestStatus @default(PENDING)
  walletTransactionId String                  @unique
  paymentReference    String?

  wallet               Wallet                           @relation(fields: [walletId], references: [id])
  walletTransaction    WalletTransaction                @relation(fields: [walletTransactionId], references: [id])
  advanceRequestOrigin AdvanceRequest?
  statusHistory        WithdrawalRequestStatusHistory[]

  createdAt DateTime @default(now())

  @@index([status])
  @@index([walletId, status])
  @@map("withdrawal_requests")
}

/// Trilha append-only das decisÃµes financeiras sobre um saque. Ela preserva
/// o responsÃ¡vel e a justificativa de aprovaÃ§Ã£o, rejeiÃ§Ã£o ou pagamento.
model WithdrawalRequestStatusHistory {
  id                  String                   @id @default(uuid())
  withdrawalRequestId String
  fromStatus          WithdrawalRequestStatus?
  toStatus            WithdrawalRequestStatus
  changedAt           DateTime                 @default(now())
  changedByUserId     String?
  note                String?

  withdrawalRequest WithdrawalRequest @relation(fields: [withdrawalRequestId], references: [id])
  changedByUser     User?             @relation(fields: [changedByUserId], references: [id])

  @@index([withdrawalRequestId])
  @@map("withdrawal_request_status_history")
}

/// Ao ser aprovada, uma antecipação libera o saldo bloqueado na hora
/// (transação CREDIT_ADVANCE_RELEASE) e o valor líquido é enviado como
/// uma WithdrawalRequest automática (resultingWithdrawalRequestId).
model AdvanceRequest {
  id                           String               @id @default(uuid())
  walletId                     String
  blockedAmountAntecipado      Decimal              @db.Decimal(10, 2)
  feeAmount                    Decimal              @db.Decimal(10, 2)
  netAmount                    Decimal              @db.Decimal(10, 2)
  status                       AdvanceRequestStatus @default(PENDING)
  resultingWithdrawalRequestId String?              @unique

  wallet                     Wallet             @relation(fields: [walletId], references: [id])
  resultingWithdrawalRequest WithdrawalRequest? @relation(fields: [resultingWithdrawalRequestId], references: [id])

  createdAt DateTime @default(now())

  @@map("advance_requests")
}

/// Agrupa pedidos faturados de uma empresa. Valores são CONGELADOS na
/// emissão — nunca recalculados a partir dos Deliveries depois de emitida.
model Invoice {
  id               String         @id @default(uuid())
  companyId        String
  number           String         @unique
  issueDate        DateTime       @db.Date
  dueDate          DateTime       @db.Date
  paymentDate      DateTime?      @db.Date
  paymentMethod    PaymentMethod?
  status           InvoiceStatus  @default(PENDING)
  totalValue       Decimal        @db.Decimal(10, 2)
  driverValueSum   Decimal        @db.Decimal(10, 2)
  platformValueSum Decimal        @db.Decimal(10, 2)

  company       Company                @relation(fields: [companyId], references: [id])
  deliveries    Delivery[]
  statusHistory InvoiceStatusHistory[]

  createdAt DateTime @default(now())

  @@index([companyId, status])
  @@index([dueDate, status])
  @@map("invoices")
}

/// Trilha append-only de mudanças da fatura. Permite responder quem fechou,
/// marcou como pago ou atualizou o status financeiro sem depender de logs da
/// aplicação.
model InvoiceStatusHistory {
  id              String         @id @default(uuid())
  invoiceId       String
  fromStatus      InvoiceStatus?
  toStatus        InvoiceStatus
  changedAt       DateTime       @default(now())
  changedByUserId String?
  note            String?

  invoice       Invoice @relation(fields: [invoiceId], references: [id])
  changedByUser User?   @relation(fields: [changedByUserId], references: [id])

  @@index([invoiceId])
  @@map("invoice_status_history")
}

// ============================================================================
// 6. CONFIGURAÇÃO / PLATAFORMA
// ============================================================================

/// Tipos de serviço oferecidos (ex.: "motoboy") — evita fixar strings soltas
/// em várias tabelas e permite o produto crescer para outras modalidades.
model ServiceType {
  id     String  @id @default(uuid())
  code   String  @unique
  name   String
  active Boolean @default(true)

  driverServiceTypes DriverServiceType[]
  deliveries         Delivery[]
  pricingTables      PricingTable[]

  createdAt DateTime @default(now())

  @@map("service_types")
}

/// Praça/região de operação da plataforma.
model Region {
  id                    String   @id @default(uuid())
  name                  String   @unique
  maxDeliveryDistanceKm Decimal? @db.Decimal(6, 2)
  active                Boolean  @default(true)

  companies      Company[]
  drivers        Driver[]
  operatingHours OperatingHours[]
  pricingTables  PricingTable[]
  surcharges     Surcharge[]

  createdAt     DateTime       @default(now())
  businessHours BusinessHour[]

  @@map("regions")
}

model OperatingHours {
  id       String   @id @default(uuid())
  regionId String
  weekday  Int
  opensAt  DateTime @db.Time
  closesAt DateTime @db.Time

  region Region @relation(fields: [regionId], references: [id])

  @@index([regionId])
  @@map("operating_hours")
}

/// Tabela de preços base por região + tipo de serviço. Sem motor de
/// cálculo implementado nesta fase — apenas persistência da configuração.
model PricingTable {
  id            String   @id @default(uuid())
  regionId      String
  serviceTypeId String
  baseFee       Decimal  @db.Decimal(10, 2)
  perKmFee      Decimal  @db.Decimal(10, 2)
  minimumFee    Decimal? @db.Decimal(10, 2)

  /// Distância já coberta pela taxa base — a "bandeirada". O perKmFee só
  /// incide no que passar daqui. Zero reproduz o modelo antigo, em que a
  /// cobrança por quilômetro começava no metro zero.
  includedDistanceKm Decimal @default(0) @db.Decimal(6, 2)

  /// Acréscimo fixo de "retorno ao local de coleta" (não proporcional à
  /// distância). Null = este serviço não tem retorno pago configurado nesta
  /// região; requiresReturn não pode ser usado em Delivery até isso existir.
  returnFee Decimal? @db.Decimal(10, 2)

  /// Só uma PricingTable por (regionId, serviceTypeId) fica active=true por
  /// vez — valores são congelados no Delivery na criação, então mudar preço
  /// é criar uma nova linha e desativar a anterior, nunca editar em lugar.
  active Boolean @default(true)

  region      Region      @relation(fields: [regionId], references: [id])
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])

  createdAt DateTime @default(now())

  @@index([regionId, serviceTypeId])
  @@index([regionId, serviceTypeId, active])
  @@map("pricing_tables")
}

model PlatformSettings {
  id String @id @default("global")

  /// Percentual do valor base+distância repassado ao entregador (ex.: 80.00
  /// = entregador fica com 80%, plataforma com 20%). Não cobre o valor de
  /// retorno, que é sempre 100% do entregador. Null = ainda não configurado
  /// pelo admin — nenhum cálculo de preço pode assumir um valor default.
  driverCommissionPercentage Decimal? @db.Decimal(5, 2)

  /// Tempo (segundos) que o motoboy tem pra responder uma oferta de
  /// despacho antes de expirar e passar pro próximo da fila. Null =
  /// ainda não configurado — criação de pedido AWAITING_DRIVER falha com
  /// erro claro em vez de usar um valor inventado.
  dispatchOfferTimeoutSeconds Int?

  /// Raio (metros) de tolerância pra fechar "retorno ao local de coleta" —
  /// distância em linha reta (Haversine) entre o motoboy e o endereço de
  /// coleta da empresa. Null = ainda não configurado — completeReturn falha
  /// com erro claro em vez de usar um raio inventado.
  returnProximityRadiusMeters Int?

  /// Liga o bloqueio de pedido fora do horário de funcionamento. Desligado por
  /// padrão: uma operação que nunca configurou horário não pode acordar um dia
  /// recusando pedidos porque a tabela está vazia.
  businessHoursEnabled Boolean @default(false)

  /// Intervalo mínimo (minutos) que a MARCAÇÃO RETROATIVA precisa respeitar
  /// entre uma etapa e a seguinte. É o que separa "esqueci de tocar o botão" de
  /// "declarei coleta e entrega no mesmo minuto e faturei sem sair do lugar".
  ///
  /// Não vale para a marcação normal, feita na hora: ali o relógio é o do
  /// servidor e uma entrega legitimamente rápida não pode ser recusada.
  /// Null = sem restrição.
  minMinutesBeforeCollect Int?
  minMinutesBeforeDeliver Int?

  updatedByUserId String?
  updatedBy       User?   @relation("PlatformSettingsUpdatedBy", fields: [updatedByUserId], references: [id])

  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

/// Taxa adicional configurável pelo admin — chuva, feriado, madrugada, alta
/// demanda. Era um esqueleto da Fase 0 com o motivo em enum; virou nome livre
/// para o admin criar quantas quiser sem migração a cada motivo novo.
model Surcharge {
  id       String        @id @default(uuid())
  regionId String
  name     String        @db.VarChar(80)
  type     SurchargeType
  /// Percentual sobre o subtotal, ou valor fixo em reais, conforme `type`.
  value    Decimal       @db.Decimal(10, 2)

  /// Quanto do adicional vai para o entregador. É percentual do próprio
  /// adicional e não do pedido, separado da comissão normal: a operação pode
  /// querer repassar todo o adicional de chuva e nada de outro.
  driverSharePercentage Decimal @default(0) @db.Decimal(5, 2)

  /// Interruptor geral. Desativar não apaga — o histórico das entregas que já
  /// pagaram a taxa continua explicável.
  active Boolean @default(true)

  /// O interruptor manual, o que o admin liga quando começa a chover.
  /// Independente das janelas: qualquer um dos dois valendo aplica a taxa.
  manuallyActive Boolean @default(false)

  region    Region              @relation(fields: [regionId], references: [id])
  schedules SurchargeSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId, active])
  @@map("surcharges")
}

/// Janela em que a taxa vale sozinha, sem ninguém acionar o interruptor.
model SurchargeSchedule {
  id          String @id @default(uuid())
  surchargeId String

  /// 0 = domingo .. 6 = sábado. Null vale para qualquer dia da semana, que é o
  /// caso de uma janela de datas como feriado.
  weekday Int?

  /// Janela de datas CIVIS, guardadas como texto "AAAA-MM-DD" de propósito: um
  /// DateTime aqui viraria meia-noite UTC e deslocaria o feriado em três horas
  /// no fuso da operação. Null nos dois significa "sem limite de data".
  startDate String? @db.VarChar(10)
  endDate   String? @db.VarChar(10)

  /// Minutos desde a meia-noite no fuso operacional. `endMinute` menor ou igual
  /// a `startMinute` significa janela que atravessa a meia-noite — o caso da
  /// madrugada.
  startMinute Int
  endMinute   Int

  surcharge Surcharge @relation(fields: [surchargeId], references: [id], onDelete: Cascade)

  @@index([surchargeId])
  @@map("surcharge_schedules")
}

// ============================================================================
// 7. INTEGRAÇÕES / NOTIFICAÇÕES
// ============================================================================

/// Estrutura para integrações futuras (iFood, AnyFone, etc.) — nenhuma
/// integração real é implementada nesta fase. credentialsRef é uma
/// REFERÊNCIA a um cofre de segredos externo, nunca o token em si.
model Integration {
  id             String              @id @default(uuid())
  companyId      String?
  provider       IntegrationProvider
  status         IntegrationStatus   @default(DISCONNECTED)
  config         Json?
  credentialsRef String?
  connectedAt    DateTime?
  lastSyncAt     DateTime?

  company Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("integrations")
}

/// Notificação persistida (independente do canal de envio). O disparo
/// funcional (FCM, Socket.IO) não é implementado nesta fase.
model Notification {
  id                String              @id @default(uuid())
  userId            String
  type              NotificationType
  channel           NotificationChannel
  title             String
  body              String
  relatedEntityType String?
  relatedEntityId   String?
  readAt            DateTime?
  sentAt            DateTime?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}
