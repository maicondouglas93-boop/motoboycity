# Copie para ".env" nesta pasta (apps/api) para desenvolvimento local.
# Os valores devem corresponder aos definidos no ".env" da raiz do monorepo
# (usado pelo docker-compose.yml para subir Postgres/Redis).

DATABASE_URL=
REDIS_HOST=
REDIS_PORT=
API_PORT=
JWT_SECRET=
CORS_ORIGINS=

# Credenciais do admin bootstrap criado por "pnpm prisma:seed" (só se
# nenhum admin existir ainda). Opcional — sem elas, usa um padrão de
# desenvolvimento óbvio (ver prisma/seed.ts). Defina em produção.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
