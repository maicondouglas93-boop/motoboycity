# Copie para ".env" nesta pasta (apps/api) para desenvolvimento local.
# Os valores devem corresponder aos definidos no ".env" da raiz do monorepo
# (usado pelo docker-compose.yml para subir Postgres/Redis).

# Em desenvolvimento local, DATABASE_URL e DIRECT_URL podem apontar para o
# mesmo PostgreSQL do Docker. No Neon, use a URL pooled em DATABASE_URL e a
# URL direta (sem "-pooler" no host) em DIRECT_URL para migrations/admin.
DATABASE_URL=
DIRECT_URL=
API_PORT=
JWT_SECRET=
CORS_ORIGINS=

# Redis — BullMQ e presença ao vivo usam a mesma conexão.
#
# Em produção/staging prefira REDIS_URL: é o que provedores gerenciados
# entregam, e ela carrega usuário, senha e porta de uma vez. Use "rediss://"
# para TLS — não existe flag separada nesse caso.
#   REDIS_URL=rediss://usuario:senha@host:6380
#
# Se a senha tiver caractere especial, ela precisa vir percent-encoded na URL
# (ex.: "@" vira "%40"); a aplicação decodifica ao conectar.
REDIS_URL=

# Fallback para desenvolvimento local, usado só quando REDIS_URL está vazia.
REDIS_HOST=
REDIS_PORT=

# Alternativa a REDIS_URL quando o provedor entrega os valores separados.
# REDIS_USERNAME/REDIS_PASSWORD também são lidos de REDISUSER/REDISPASSWORD,
# que são os nomes injetados pelo Railway.
REDIS_USERNAME=
REDIS_PASSWORD=
# Ligue TLS quando usar host/porta em vez de uma URL "rediss://".
REDIS_TLS=

# 0, 4 ou 6. Use 0 em rede privada dual-stack — algumas expõem o Redis só em
# IPv6, e sem isso a conexão falha com ENOTFOUND mesmo com a URL correta.
REDIS_FAMILY=

# Chave da Google Maps Routes API (billing ativo na conta Google Cloud;
# a chave precisa ser sem restrição de app Android/HTTP referrer, já que
# a chamada é servidor-a-servidor — uma chave restrita a app falha com
# REQUEST_DENIED). Sem ela, GoogleMapsService lança
# GoogleMapsNotConfiguredError de forma clara em vez de inventar uma
# distância — configure quando tiver a chave, não é bloqueante pra
# rodar o resto da API.
GOOGLE_MAPS_API_KEY=

# Secretária Virtual (Groq). Configure somente no backend/secret manager.
# Nunca use NEXT_PUBLIC_ nem envie esta chave aos navegadores.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=30000

# Armazenamento externo de fotos e documentos. A chave privada fica somente na API.
IMAGEKIT_ID=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Credenciais do admin bootstrap criado por "pnpm prisma:seed" (só se
# nenhum admin existir ainda). Opcional — sem elas, usa um padrão de
# desenvolvimento óbvio (ver prisma/seed.ts). Defina em produção.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Rate limit da API (padrao: 30 requisicoes por 60000 ms). Em E2E, eleve o
# limite: a suite inteira sai de um IP so e estoura o limite de producao
# conforme cresce, quebrando um teste qualquer com 429.
THROTTLE_LIMIT=
THROTTLE_TTL_MS=

# ---------------------------------------------------------------------------
# PUSH (Firebase Cloud Messaging) — credencial de SERVIDOR
#
# Sao os tres campos do JSON de "Conta de servico" do Firebase:
#   Console -> Configuracoes do projeto -> Contas de servico
#            -> Gerar nova chave privada
#
# Nao confundir com as variaveis FIREBASE_* comentadas acima: aquelas sao a
# configuracao do app WEB (chave de navegador). Estas aqui sao do servidor, e a
# private key e segredo de verdade.
#
# Sem as tres, a API sobe normalmente e registra "Push desligado" no log — a
# oferta continua chegando so pelo socket, com o aplicativo aberto.
#
# A private key tem quebras de linha. Cole-a numa linha so, usando \n literais,
# entre aspas duplas — a API desfaz o escape sozinha. Exemplo da forma:
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
