# Copie para ".env.local" nesta pasta (apps/company-web) para desenvolvimento local.

NEXT_PUBLIC_API_URL=

# Chave do Google Maps usada NO NAVEGADOR (Maps JavaScript API + Places API).
#
# Sem ela o autocomplete de endereco nao devolve sugestao, e como o formulario
# exige um endereco escolhido no Google, a criacao de pedido com destino
# conhecido e o cadastro do endereco de coleta ficam bloqueados.
#
# Precisa ser uma credencial SEPARADA da GOOGLE_MAPS_API_KEY do servidor: o
# prefixo NEXT_PUBLIC_ embute o valor no pacote JavaScript, visivel para
# qualquer visitante. Restrinja por HTTP referrer (em dev: http://localhost:3000/*)
# e autorize apenas as duas APIs acima.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
