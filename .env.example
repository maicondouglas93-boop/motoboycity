# ==============================================================================
# MOTOboyCity — Variáveis de ambiente (Fase 0: fundação técnica)
# Copie este arquivo para ".env" e preencha com valores locais.
# NUNCA commitar o arquivo ".env" com valores reais.
# ==============================================================================

# --- PostgreSQL (apps/api, docker-compose) ---
# Se a porta padrão 5432 já estiver em uso (ex.: um PostgreSQL nativo
# instalado na máquina), escolha outra porta livre (ex.: 5434) e ajuste
# DATABASE_URL de acordo.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# Em desenvolvimento local, as duas URLs podem ser iguais. No Neon, use a URL
# pooled em DATABASE_URL e a URL direta em DIRECT_URL.
DATABASE_URL=
DIRECT_URL=

# --- Redis (apps/api, docker-compose) ---
REDIS_HOST=
REDIS_PORT=
REDIS_URL=

# --- API (apps/api) ---
API_PORT=
JWT_SECRET=
# Origens permitidas por CORS, separadas por vírgula. Se vazio, a API usa um
# padrão de dev (localhost:3000-3002). Defina explicitamente em produção.
CORS_ORIGINS=
# Limite em ms para o log de requisicoes lentas (sem URL/query/body).
SLOW_REQUEST_THRESHOLD_MS=750
# Chave da Google Maps Routes API (billing ativo; sem restrição de app
# Android/HTTP referrer — a chamada é servidor-a-servidor). Sem ela, o
# cálculo de distância real falha com erro claro — não é bloqueante pra
# rodar a API.
GOOGLE_MAPS_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=30000

# --- Front-ends (apps/company-web, apps/admin-web) ---
NEXT_PUBLIC_API_URL=
API_URL=
